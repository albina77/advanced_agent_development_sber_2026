MEMORY_PREFERENCE_DAYS=180
MEMORY_EPISODE_DAYS=30
MEMORY_SERVICE_RETENTION_DAYS=365
MEMORY_MIN_SIMILARITY=0.10
CONTEXT_INPUT_TOKENS=4096
RAG_INPUT_TOKENS=12000
CONTEXT_SUMMARY_TOKENS=384
CONTEXT_RECENT_TURNS=4
MODEL_MAX_OUTPUT_TOKENS=1024
RAG_MAX_OUTPUT_TOKENS=2048
